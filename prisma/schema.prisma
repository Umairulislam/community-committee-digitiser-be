generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CommitteeStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PayoutMethod {
  LOTTERY
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  committees   Committee[]

  @@map("users")
}

model Committee {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  contributionAmount Decimal         @db.Decimal(12, 2)
  memberLimit        Int
  totalCycles        Int
  payoutMethod       PayoutMethod    @default(LOTTERY)
  startDate          DateTime
  dueDay             Int
  status             CommitteeStatus @default(DRAFT)
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@map("committees")
}
