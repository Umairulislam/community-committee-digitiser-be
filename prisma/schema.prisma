generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CommitteeStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PayoutMethod {
  LOTTERY
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  INVITED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  committees   Committee[]
  memberships  CommitteeMember[]
  invitations  Invitation[]

  @@map("users")
}

model Committee {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  contributionAmount Decimal         @db.Decimal(12, 2)
  memberLimit        Int
  totalCycles        Int
  payoutMethod       PayoutMethod    @default(LOTTERY)
  startDate          DateTime
  dueDay             Int
  status             CommitteeStatus @default(DRAFT)
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creator    User              @relation(fields: [createdBy], references: [id])
  members    CommitteeMember[]
  invitations Invitation[]
  cycles     Cycle[]

  @@map("committees")
}

model CommitteeMember {
  id          String       @id @default(uuid())
  committeeId String
  userId      String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(INVITED)
  joinedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  committee Committee @relation(fields: [committeeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, committeeId])
  @@map("committee_members")
}

model Invitation {
  id          String           @id @default(uuid())
  committeeId String
  invitedBy   String
  email       String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  committee Committee @relation(fields: [committeeId], references: [id])
  inviter   User      @relation(fields: [invitedBy], references: [id])

  @@map("invitations")
}

model Cycle {
  id            String      @id @default(uuid())
  committeeId   String
  cycleNumber   Int
  startDate     DateTime?
  endDate       DateTime?
  status        CycleStatus @default(UPCOMING)
  totalExpected Decimal     @default(0) @db.Decimal(12, 2)
  totalCollected Decimal    @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  committee Committee @relation(fields: [committeeId], references: [id])

  @@unique([committeeId, cycleNumber])
  @@map("cycles")
}
